# FinPilot Agent Configuration
# Copy to .env and customize

# Database
DATABASE_URL=sqlite+aiosqlite:///./finpilot_agent.db
DB_ECHO=false

# Security (CHANGE IN PRODUCTION)
API_KEY_SALT=finpilot-secure-salt-change-in-production
AUDIT_HMAC_SECRET=audit-hmac-secret-change-in-production
RATE_LIMIT_PER_MINUTE=60

# LLM (optional - falls back to deterministic mode if unset)
# ANTHROPIC_API_KEY=sk-ant-xxx
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Server
HOST=0.0.0.0
PORT=8100
DEBUG=false

# CORS
CORS_ORIGINS=["*"]

# Tenant defaults
DEFAULT_CURRENCY=CNY
DEFAULT_COUNTRY=CN
