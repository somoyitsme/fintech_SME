# FinPilot Production Configuration
# All values REQUIRED for real operation - no defaults for secrets

# ── Real Database Connection (REQUIRED) ──
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
# MySQL:      mysql+aiomysql://user:pass@host:3306/dbname
# SQLite:     sqlite+aiosqlite:///./path/to/database.db
DATABASE_URL=

# Read-only role for agent queries (SECURITY: agent NEVER writes)
# Create with: CREATE ROLE finpilot_ro LOGIN PASSWORD '...'; GRANT SELECT ON ALL TABLES IN SCHEMA public TO finpilot_ro;
DB_READONLY_PASSWORD=

# ── Anthropic LLM (REQUIRED) ──
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096

# ── Security Secrets (REQUIRED - generate with: openssl rand -hex 32) ──
API_KEY_SALT=
AUDIT_HMAC_SECRET=
# Shared API key for /chat endpoint authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AGENT_API_KEY=

# ── Server ──
HOST=0.0.0.0
PORT=8100
DEBUG=false

# ── CORS (restrict to your SME site domain - replace with your actual domain) ──
# Examples: ["https://yourapp.com"], ["http://localhost:3000","http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# ── Tenant defaults ──
DEFAULT_CURRENCY=CNY
DEFAULT_COUNTRY=CN

# ── Schema introspection: tables the agent is allowed to read ──
ALLOWED_TABLES=invoices,expenses,bank_accounts,customers,sales,inventory,payments,vendors
