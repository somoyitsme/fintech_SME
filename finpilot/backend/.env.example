# FinPilot Environment Configuration
APP_NAME=FinPilot
APP_ENV=production
DEBUG=False
SECRET_KEY=finpilot-super-secret-key-replace-in-production-2026

# Database (PostgreSQL for Docker/Production, SQLite for local dev)
DATABASE_URL=sqlite:///./finpilot.db
# DATABASE_URL=postgresql://finpilot:finpilot123@db:5432/finpilot

# Google Gemini API Key (Optional: system runs with offline deterministic expert synthesizer if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]
